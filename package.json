{
  "name": "Lojinha",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-reservas": "cds watch --open reservas/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy Lojinha --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-materiais": "cds watch --open sap.fe.demo.materiais/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-funcionarios": "cds watch --open sap.fe.demo.funcionarios.funcionarios/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "html5-repo": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/reservas",
    "app/materiais",
    "app/funcionarios"
  ]
}
